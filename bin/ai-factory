#!/usr/bin/env bash
# ai-factory - start the zellij AI factory workspace for the current git repository.
set -euo pipefail

usage() {
    cat <<'EOF'
ai-factory - zellij AI factory workspace

Run this command inside a git repository. It starts a zellij session
"<repo>-factory" with these tabs:

  Tab 1  "Planner - <repo>"
         clauded on claude-fable-5. No draft prompt.

  Tab 2  "AI factory - <repo>"
         Refiner      opencoded on openai/gpt-5.6-sol
         Reviewer     opencoded on openai/gpt-5.6-sol
         Implementer  opencoded on zai-coding-plan/glm-5.3-flash
         Releaser     clauded on claude-opus-5

Each factory pane gets its prompt typed in and waits. Move to a pane,
check the text, then press Enter to send it.

USAGE
  ai-factory [help] [--skip <list>]

COMMANDS
  help              Show this help.

OPTIONS
  --skip <list>     Do not start the given tabs or panes.
                    Items: planner, factory, refiner, reviewer,
                           implementer, releaser
                    Separate items with a comma.

EXAMPLES
  ai-factory
      Start the full workspace.

  ai-factory --skip planner
      Start only the AI factory tab.

  ai-factory --skip refiner,reviewer
      Start the factory without the two gpt-5.6-sol panes.

  ai-factory --skip factory
      Start only the Planner tab.

FILES
  ~/.config/zellij/layouts/ai-factory.kdl   Layout template. Models and
                                            pane commands live here.
  ~/.config/zellij/prompts/*.md             Draft prompts. Edit these files.
  ~/.config/zellij/themes/retro-future.kdl  Color theme.

NOTES
  - If the session already runs, this command attaches to it and
    ignores --skip.
  - Claude asks for folder trust on first use. Accept it, then start
    the workspace again.
  - zellij keys: Ctrl t = tabs, Ctrl p = panes, Alt hjkl = move focus,
    Ctrl q = leave the session. The session keeps running.
EOF
}

skip=""
while [[ $# -gt 0 ]]; do
    case "$1" in
    help | -h | --help)
        usage
        exit 0
        ;;
    --skip)
        skip="${2-}"
        shift 2
        ;;
    --skip=*)
        skip="${1#*=}"
        shift
        ;;
    *)
        printf 'Unknown argument: %s\n\n' "$1" >&2
        usage >&2
        exit 2
        ;;
    esac
done

root="$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")"
repo="$(basename "$root")"
session="${repo}-factory"
zdir="${XDG_CONFIG_HOME:-$HOME/.config}/zellij"
template="${zdir}/layouts/ai-factory.kdl"

rendered="$(mktemp "${TMPDIR:-/tmp}/${session}.XXXXXX.kdl")"
trap 'rm -f "$rendered"' EXIT

python3 - "$template" "$rendered" "$root" "$repo" "${zdir}/prompts" "$skip" <<'PY'
import re
import sys

tpl, out, root, repo, prompts, skip = sys.argv[1:7]
skipset = {s.strip().lower() for s in skip.split(',') if s.strip()}
known = {"planner", "factory", "refiner", "reviewer", "implementer", "releaser"}
unknown = skipset - known
for token in sorted(unknown):
    print(f"ai-factory: unknown skip item '{token}' - ignored", file=sys.stderr)

text = open(tpl).read()


def block(text, kw_start):
    n = len(text)
    i = kw_start
    in_str = False
    while i < n:
        c = text[i]
        if in_str:
            if c == '"':
                in_str = False
        elif c == '"':
            in_str = True
        elif c == "{":
            break
        i += 1
    depth = 0
    j = i
    in_str = False
    while j < n:
        c = text[j]
        if in_str:
            if c == '"':
                in_str = False
        elif c == '"':
            in_str = True
        elif c == "{":
            depth += 1
        elif c == "}":
            depth -= 1
            if depth == 0:
                break
        j += 1
    end = j + 1
    if end < n and text[end] == "\n":
        end += 1
    ls = text.rfind("\n", 0, kw_start) + 1
    start = ls if text[ls:kw_start].strip() == "" else kw_start
    return start, end


def drop_nodes(text, regex, label=None):
    while True:
        m = regex.search(text)
        if not m:
            return text
        s, e = block(text, m.start())
        text = text[:s] + text[e:]


roles = [r for r in ("refiner", "reviewer", "implementer", "releaser") if r in skipset]
if roles:
    text = drop_nodes(text, re.compile(r'pane name="(?:%s)"' % "|".join(roles), re.IGNORECASE))

if "planner" in skipset:
    text = drop_nodes(text, re.compile(r'tab name="Planner', re.IGNORECASE))
if "factory" in skipset:
    text = drop_nodes(text, re.compile(r'tab name="AI factory', re.IGNORECASE))

while True:
    m = re.search(r'pane split_direction="[a-z]+" \{\s*\}\n?', text)
    if not m:
        break
    text = text[: m.start()] + text[m.end():]

while True:
    removed = False
    for m in re.finditer(r'tab name="[^"]+"', text):
        s, e = block(text, m.start())
        if "pane" not in text[s:e]:
            text = text[:s] + text[e:]
            removed = True
            break
    if not removed:
        break

if "tab name=" not in text:
    print(
        "ai-factory: every tab was skipped - nothing to start",
        file=sys.stderr,
    )
    sys.exit(1)

text = (
    text.replace("{{CWD}}", root)
    .replace("{{REPO}}", repo)
    .replace("{{PROMPTS}}", prompts)
)
open(out, "w").write(text)
PY

if zellij list-sessions --no-formatting 2>/dev/null | grep -qx "$session"; then
    printf 'Session %s already runs. Attaching.\n' "$session"
    exec zellij attach "$session"
fi
exec zellij --new-session-with-layout "$rendered" --session "$session"
