layout {
    cwd "{{CWD}}"

    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Planner - {{REPO}}" focus=true {
        pane name="Planner" command="clauded" {
            args "--role" "Planner" "--model" "claude-fable-5[1m]"
        }
    }

    tab name="AI factory - {{REPO}}" {
        pane split_direction="vertical" {
            pane split_direction="horizontal" {
                pane name="Refiner" command="codexd" {
                    args "--role" "Refiner" "--model" "gpt-5.6-sol" "--draft-file" "{{PROMPTS}}/refiner.md"
                }
                pane name="Reviewer" command="codexd" {
                    args "--role" "Reviewer" "--model" "gpt-5.6-sol" "--draft-file" "{{PROMPTS}}/reviewer.md"
                }
            }
            pane split_direction="horizontal" {
                pane name="Implementer" command="opencoded" {
                    args "--role" "Implementer" "--model" "zai-coding-plan/glm-5.3-flash" "--draft-file" "{{PROMPTS}}/implementer.md"
                }
                pane name="Releaser" command="clauded" {
                    args "--role" "Releaser" "--model" "claude-opus-5[1m]" "--draft-file" "{{PROMPTS}}/releaser.md"
                }
            }
        }
    }
}
