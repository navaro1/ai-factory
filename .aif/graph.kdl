graph {
    tick "30m"
    limit 3

    node "planner" {
        agent "claude"
        model "claude-fable-5[1m]"
        exec "supervised"
    }
    node "refiner" {
        agent "opencode"
        model "openai/gpt-5.6-sol"
        exec "supervised"
        when "issue has label 'to-refine'"
        prompt "zellij/prompts/refiner.md"
    }
    node "implementer" {
        agent "opencode"
        model "zai-coding-plan/glm-5.3-flash"
        exec "supervised"
        when "issue has label 'refined' and dependencies met"
        prompt "zellij/prompts/implementer.md"
    }
    node "reviewer" {
        agent "opencode"
        model "openai/gpt-5.6-sol"
        exec "supervised"
        when "pr is draft"
        prompt "zellij/prompts/reviewer.md"
    }
    node "releaser" {
        agent "claude"
        model "claude-opus-5[1m]"
        exec "supervised"
        when "pr is open and not draft"
        prompt "zellij/prompts/releaser.md"
    }

    edge from="refiner" to="implementer" on="label flips to refined"
    edge from="implementer" to="reviewer" on="draft pr opens"
    edge from="reviewer" to="releaser" on="pr leaves draft"
}
